# OPDI Environment Variables
# Copy this file to .env and fill in the values.
# The .env file is loaded automatically by OPDIConfig and is excluded from git.

# OpenSky S3 credentials (for the "opensky" environment)
AWS_ACCESS_KEY_ID=eurocontrol
AWS_SECRET_ACCESS_KEY=

# OpenSky Network credentials (for MinIO CLI ingestion in dev/live)
# OSN_USERNAME=
# OSN_KEY=
