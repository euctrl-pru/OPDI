# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
ENV/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Testing
.pytest_cache/
.coverage
htmlcov/

# Sphinx docs
docs/_build/

# Data artifacts
data/
*.parquet
# The reference outputs of the golden-output test are small and must be committed.
!tests/golden/**/*.parquet
*.csv
*.csv.gz
!requirements*.txt

# ...except EUROCONTROL ground truth, which IS committed, via git-lfs.
# Without this negation the blanket *.parquet above silently swallows every
# extract and `git add` reports nothing. See reference/README.md.
!reference/**/*.parquet

# Logs
logs/
OPDI_live/

# OS
.DS_Store
Thumbs.db

# MinIO client
mc

# Environment variables
.env

# Jupyter scratch
.ipynb_checkpoints/
**/.ipynb_checkpoints/
.claude/worktrees/

# osmnx response cache. Regenerable, machine-local, and swept into a commit
# by `git add -A` once already.
cache/

# Curated reference tables that ship inside the package.
!src/opdi/reference/data/
!src/opdi/reference/data/*.csv
